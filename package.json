{
  "name": "backport-github-action",
  "version": "12.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npx ncc build src/index.ts -o dist",
    "prepare": "husky",
    "lint": "eslint '{src,scripts}/**/*.ts' && tsc --noEmit --project tsconfig.eslint.json",
    "test": "vitest run",
    "test:e2e": "npx tsx scripts/smoke-test/smoke-test.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "backport": "^12.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@octokit/rest": "^22.0.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vercel/ncc": "^0.44.0",
    "chalk": "^5.6.2",
    "eslint": "^10.5.0",
    "eslint-plugin-import-x": "^4.16.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "p-retry": "^8.0.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.ts": "eslint --cache --fix"
  }
}
