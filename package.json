{
  "name": "backport-github-action",
  "version": "11.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npx ncc build src/index.ts -o dist",
    "prepare": "husky",
    "lint": "eslint './**/*.{ts,js}'",
    "test": "vitest run",
    "test:e2e": "npx tsx scripts/smoke-test/smoke-test.ts",
    "release": "npx tsx scripts/release/release.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "backport": "11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@octokit/rest": "^22.0.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vercel/ncc": "^0.38.4",
    "chalk": "^5.6.2",
    "eslint": "^10.0.3",
    "eslint-plugin-import-x": "^4.16.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "p-retry": "^7.1.1",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*.ts": "eslint --cache --fix"
  }
}
